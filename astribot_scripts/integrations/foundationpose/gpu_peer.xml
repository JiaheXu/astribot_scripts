<?xml version="1.0"?>
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <!-- Keep RTPS datagrams below the routed Ethernet MTU. Large default UDP
       datagrams exhausted this host's IP fragment-reassembly queue. -->
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>camera_udp</transport_id><type>UDPv4</type>
      <maxMessageSize>1400</maxMessageSize>
      <sendBufferSize>1048576</sendBufferSize>
      <receiveBufferSize>1048576</receiveBufferSize>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="astribot_camera_peer" is_default_profile="true">
    <rtps>
      <useBuiltinTransports>false</useBuiltinTransports>
      <userTransports><transport_id>camera_udp</transport_id></userTransports>
      <builtin><initialPeersList>
      <locator><udpv4><address>192.168.100.102</address></udpv4></locator>
      <locator><udpv4><address>239.255.0.1</address></udpv4></locator>
      <locator><udpv4><address>127.0.0.1</address></udpv4></locator>
    </initialPeersList></builtin></rtps>
  </participant>
</profiles>
