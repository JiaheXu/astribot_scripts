Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 35; 35; 40
    Fixed Frame: astribot_viz_chassis
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Ground grid
      Enabled: true
      Cell Size: 0.5
      Plane Cell Count: 10
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/RobotModel
      Name: Robot (current joints)
      Enabled: true
      Alpha: 0.7
      Visual Enabled: true
      Collision Enabled: false
      Description Source: Topic
      Description Topic:
        Value: /astribot_viz/robot_description
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/MarkerArray
      Name: Current Cartesian poses
      Enabled: true
      Marker Topic:
        Value: /astribot_viz/current_poses
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 10
    - Class: rviz_default_plugins/MarkerArray
      Name: Desired Cartesian poses
      Enabled: true
      Marker Topic:
        Value: /astribot_viz/desired_poses
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 10
    - Class: rviz_default_plugins/Image
      Name: Head RGB
      Enabled: true
      Topic:
        Value: /sdk/astribot_camera/head_rgbd/color_image
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Transport Hint: raw
      Normalize Range: true
    - Class: rviz_default_plugins/Image
      Name: Head depth
      Enabled: true
      Topic:
        Value: /sdk/astribot_camera/head_rgbd/depth_image
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Transport Hint: raw
      Normalize Range: true
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 3.5
      Focal Point:
        X: 0.15
        Y: 0
        Z: 0.8
      Pitch: 0.35
      Yaw: 0.8
      Target Frame: <Fixed Frame>
  Enabled: true
Window Geometry:
  Width: 1280
  Height: 900
